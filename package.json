{
  "name": "archiv-wiki",
  "productName": "Archiv-Wiki",
  "version": "1.9.0",
  "description": "Persönliches Markdown-Wiki für den Desktop – Notizen, Setups und Checklisten, 100% lokal.",
  "main": "main.js",
  "author": {
    "name": "Smashinger",
    "email": "smashii@example.com"
  },
  "homepage": "https://github.com/Smashinger/archiv-wiki",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "build:vendor": "node build/build.mjs",
    "dist": "electron-builder",
    "release": "electron-builder --publish always",
    "postinstall": "electron-builder install-app-deps"
  },
  "devDependencies": {
    "electron": "^28.2.0",
    "electron-builder": "^24.13.3",
    "esbuild": "^0.28.1",
    "@codemirror/commands": "^6.10.4",
    "@codemirror/lang-markdown": "^6.5.1",
    "@codemirror/language": "^6.12.4",
    "@codemirror/autocomplete": "^6.20.0",
    "@codemirror/search": "^6.5.11",
    "@codemirror/state": "^6.7.1",
    "flexsearch": "^0.8.212",
    "@codemirror/view": "^6.43.6",
    "@lezer/highlight": "^1.2.3",
    "highlight.js": "^11.11.1",
    "katex": "^0.17.0",
    "marked": "^18.0.6"
  },
  "dependencies": {
    "gray-matter": "^4.0.3",
    "archiver": "^8.0.0",
    "webdav": "^5.10.0"
  },
  "build": {
    "appId": "de.smashii.archivwiki",
    "productName": "Archiv-Wiki",
    "copyright": "Copyright © 2026 smashii",
    "files": [
      "main.js",
      "main/**/*",
      "preload.js",
      "renderer/**/*",
      "assets/**/*",
      "!renderer/**/*.map"
    ],
    "asarUnpack": [
      "assets/icons/**/*"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "src/resources"
    },
    "publish": {
      "provider": "github",
      "owner": "Smashinger",
      "repo": "archiv-wiki",
      "releaseType": "draft"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "executableName": "archiv-wiki",
      "category": "Office",
      "icon": "assets/icons",
      "synopsis": "Persönliches Markdown-Wiki für den Desktop",
      "description": "Ein lokales, Electron-basiertes Wiki für Notizen, Setups und Checklisten. Keine Cloud-Pflicht, keine Telemetrie."
    }
  }
}
